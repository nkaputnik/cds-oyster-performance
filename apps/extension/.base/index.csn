    "BenchmarkEvidenceService": {
      "kind": "service",
      "@source": "srv/evidence-service.cds",
      "@path": "/benchmark-evidence",
      "@requires": "BenchmarkRecorder"
    },
    "BenchmarkEvidenceService.Runs": {
      "kind": "entity",
      "@readonly": true,
      "projection": {
        "from": {
          "ref": [
            "benchmark.evidence.Runs"
          ]
        },
        "excluding": [
          "artifacts"
        ]
      }
    },
    "BenchmarkEvidenceService.Artifacts": {
      "kind": "entity",
      "@readonly": true,
      "projection": {
        "from": {
          "ref": [
            "benchmark.evidence.Artifacts"
          ]
        },
        "excluding": [
          "parts"
        ]
      }
    },
    "BenchmarkEvidenceService.beginRun": {
      "kind": "action",
      "params": {
        "manifest": {
          "type": "cds.LargeString"
        }
      },
      "returns": {
        "type": "BenchmarkEvidenceService.Runs"
      }
    },
    "BenchmarkEvidenceService.beginArtifact": {
      "kind": "action",
      "params": {
        "runID": {
          "type": "cds.UUID"
        },
        "path": {
          "type": "cds.String",
          "length": 1024
        },
        "originalBytes": {
          "type": "cds.Integer64"
        },
        "compressedBytes": {
          "type": "cds.Integer64"
        },
        "originalSha256": {
          "type": "cds.String",
          "length": 64
        },
        "compressedSha256": {
          "type": "cds.String",
          "length": 64
        },
        "partCount": {
          "type": "cds.Integer"
        }
      },
      "returns": {
        "type": "BenchmarkEvidenceService.Artifacts"
      }
    },
    "BenchmarkEvidenceService.putPart": {
      "kind": "action",
      "params": {
        "artifactID": {
          "type": "cds.UUID"
        },
        "ordinal": {
          "type": "cds.Integer"
        },
        "content": {
          "type": "cds.LargeBinary"
        }
      }
    },
    "BenchmarkEvidenceService.completeArtifact": {
      "kind": "action",
      "params": {
        "artifactID": {
          "type": "cds.UUID"
        }
      },
      "returns": {
        "type": "BenchmarkEvidenceService.Artifacts"
      }
    },
    "BenchmarkEvidenceService.getPart": {
      "kind": "action",
      "params": {
        "artifactID": {
          "type": "cds.UUID"
        },
        "ordinal": {
          "type": "cds.Integer"
        }
      },
      "returns": {
        "type": "cds.LargeBinary"
      }
    },
    "BenchmarkEvidenceService.finishRun": {
      "kind": "action",
      "params": {
        "runID": {
          "type": "cds.UUID"
        },
        "status": {
          "type": "cds.String",
          "length": 16
        },
        "finalArtifactID": {
          "type": "cds.UUID"
        }
      },
      "returns": {
        "type": "BenchmarkEvidenceService.Runs"
      }
    },
