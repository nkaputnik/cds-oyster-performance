{
  "namespace": "benchmark.evidence",
  "definitions": {
    "benchmark.evidence.Runs": {
      "kind": "entity",
      "includes": [
        "cuid",
        "managed"
      ],
      "elements": {
        "manifest": {
          "type": "cds.LargeString"
        },
        "status": {
          "type": "cds.String",
          "length": 16,
          "default": {
            "val": "open"
          }
        },
        "finishedAt": {
          "type": "cds.Timestamp"
        },
        "finalArtifact": {
          "type": "cds.Association",
          "target": "benchmark.evidence.Artifacts"
        },
        "artifacts": {
          "type": "cds.Composition",
          "cardinality": {
            "max": "*"
          },
          "target": "benchmark.evidence.Artifacts",
          "on": [
            {
              "ref": [
                "artifacts",
                "run"
              ]
            },
            "=",
            {
              "ref": [
                "$self"
              ]
            }
          ]
        }
      }
    },
    "benchmark.evidence.Artifacts": {
      "kind": "entity",
      "@assert.unique.runPath": [
        {
          "=": "run"
        },
        {
          "=": "path"
        }
      ],
      "includes": [
        "cuid",
        "managed"
      ],
      "elements": {
        "run": {
          "type": "cds.Association",
          "target": "benchmark.evidence.Runs",
          "notNull": true
        },
        "path": {
          "type": "cds.String",
          "length": 1024,
          "notNull": true
        },
        "originalBytes": {
          "type": "cds.Integer64",
          "notNull": true
        },
        "compressedBytes": {
          "type": "cds.Integer64",
          "notNull": true
        },
        "originalSha256": {
          "type": "cds.String",
          "length": 64,
          "notNull": true
        },
        "compressedSha256": {
          "type": "cds.String",
          "length": 64,
          "notNull": true
        },
        "partCount": {
          "type": "cds.Integer",
          "notNull": true
        },
        "compression": {
          "type": "cds.String",
          "length": 8,
          "default": {
            "val": "gzip"
          }
        },
        "status": {
          "type": "cds.String",
          "length": 16,
          "default": {
            "val": "pending"
          }
        },
        "completedAt": {
          "type": "cds.Timestamp"
        },
        "parts": {
          "type": "cds.Composition",
          "cardinality": {
            "max": "*"
          },
          "target": "benchmark.evidence.ArtifactParts",
          "on": [
            {
              "ref": [
                "parts",
                "artifact"
              ]
            },
            "=",
            {
              "ref": [
                "$self"
              ]
            }
          ]
        }
      }
    },
    "benchmark.evidence.ArtifactParts": {
      "kind": "entity",
      "@assert.unique.artifactOrdinal": [
        {
          "=": "artifact"
        },
        {
          "=": "ordinal"
        }
      ],
      "includes": [
        "cuid"
      ],
      "elements": {
        "artifact": {
          "type": "cds.Association",
          "target": "benchmark.evidence.Artifacts",
          "notNull": true
        },
        "ordinal": {
          "type": "cds.Integer",
          "notNull": true
        },
        "bytes": {
          "type": "cds.Integer",
          "notNull": true
        },
        "content": {
          "type": "cds.LargeBinary",
          "notNull": true
        }
      }
    },
    "perf.TechnicalRow": {
      "kind": "aspect",
      "elements": {
        "ID": {
          "key": true,
          "type": "cds.Integer"
        },
        "groupNo": {
          "type": "cds.Integer"
        },
        "value": {
          "type": "cds.Integer"
        },
        "text": {
          "type": "cds.String",
          "length": 32
        }
      }
    },
    "perf.SmallRows": {
      "kind": "entity",
      "includes": [
        "perf.TechnicalRow"
      ],
      "elements": {}
    },
    "perf.LargeRows": {
      "kind": "entity",
      "includes": [
        "perf.TechnicalRow"
      ],
      "elements": {}
    },
    "perf.WriteRows": {
      "kind": "entity",
      "includes": [
        "perf.TechnicalRow"
      ],
      "elements": {
        "lookupID": {
          "type": "cds.Integer"
        },
        "effectID": {
          "type": "cds.Integer"
        },
        "quantity": {
          "type": "cds.Integer",
          "default": {
            "val": 1
          }
        },
        "unitPrice": {
          "type": "cds.Integer",
          "default": {
            "val": 1
          }
        }
      }
    },
    "perf.LookupRows": {
      "kind": "entity",
      "includes": [
        "perf.TechnicalRow"
      ],
      "elements": {
        "limit": {
          "type": "cds.Integer",
          "default": {
            "val": 1000
          }
        }
      }
    },
    "perf.SideEffectRows": {
      "kind": "entity",
      "includes": [
        "perf.TechnicalRow"
      ],
      "elements": {}
    },
    "BenchmarkService": {
      "kind": "service",
      "@source": "srv/benchmark-service.cds",
      "@path": "/benchmark"
    },
    "BenchmarkService.NoHandlerWriteRows": {
      "kind": "entity",
      "projection": {
        "from": {
          "ref": [
            "perf.WriteRows"
          ]
        }
      }
    },
    "BenchmarkService.NoHandlerSmallRows": {
      "kind": "entity",
      "projection": {
        "from": {
          "ref": [
            "perf.SmallRows"
          ]
        },
        "columns": [
          "*",
          {
            "virtual": true,
            "val": null,
            "as": "checksum",
            "cast": {
              "type": "cds.Integer"
            }
          }
        ]
      }
    },
