{
  "name": "oyster-benchmark-app",
  "version": "1.0.0",
  "type": "commonjs",
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap/cds": "^10",
    "@sap/cds-mtxs": "^4",
    "@sap/xssec": "^4",
    "@sap/cds-oyster": "latest"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "private": true,
  "cds": {
    "requires": {
      "[production]": {
        "auth": "xsuaa",
        "multitenancy": true
      },
      "[with-mtx]": {
        "multitenancy": true
      },
      "extensibility": {
        "extension-allowlist": []
      },
      "code-extensibility": {
        "sandbox": "wasm"
      }
    },
    "profile": "with-mtx-sidecar",
    "query": {
      "limit": {
        "default": 1000,
        "max": 10000
      }
    }
  }
}
