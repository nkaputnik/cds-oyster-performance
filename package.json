{
  "name": "cds-oyster-performance",
  "version": "1.0.0",
  "dependencies": {
    "@sap/cds": "latest",
    "@sap/cds-mtxs": "latest",
    "@sap/cds-oyster": "latest",
    "@cap-js/sqlite": "latest"
  },
  "scripts": {
    "start": "cds serve --project apps/extension",
    "deploy": "npm run deploy --workspace apps/extension",
    "benchmark": "node bench/run.js --suite short",
    "benchmark:long": "node bench/run.js --suite long",
    "cloud:build": "node apps/runner/build.js gen/runner",
    "cloud:export": "node bench/cloud/export.js",
    "btp": "node bench/cloud/shared.js",
    "btp:setup-login": "node bench/cloud/login-service.js",
    "test": "node --test test/*.test.js",
    "verify": "node bench/verify.js",
    "report": "node bench/reports.js",
    "overview": "node bench/overview.js"
  },
  "private": true,
  "workspaces": [
    "apps/baseline-plain",
    "apps/provider",
    "apps/provider/mtx/sidecar",
    "apps/runner",
    "apps/extension",
    "apps/extension/.base"
  ],
  "devDependencies": {
    "@sap/cds-dk": "latest",
    "autocannon": "latest"
  },
  "description": "Local and BTP CAP and Oyster performance comparisons",
  "engines": {
    "node": ">=22.18.0"
  }
}
